[Unit]
Description=Hy-MT2-7B Translation (Quality: Q6_K, single slot, Q8 KV)
After=network.target
Conflicts=hy-mt2-throughput.service

[Service]
Type=simple
ExecStart=/usr/local/share/mise/installs/llama-cpp/9294-cuda/llama-server \
  -m /ssd/mirror-rootfs/home/obj/models/hy-mt2/Hy-MT2-7B.i1-Q6_K.gguf \
  -ngl 99 \
  -fa on \
  -ctk q8_0 -ctv q8_0 \
  -c 16384 \
  --parallel 1 \
  --temp 0.7 \
  --top-k 20 \
  --top-p 0.6 \
  --repeat-penalty 1.05 \
  --host 127.0.0.1 \
  --port 8401
Restart=on-failure
RestartSec=5
Environment=CUDA_VISIBLE_DEVICES=0
Environment=LD_LIBRARY_PATH=/usr/local/share/mise/installs/llama-cpp/9294-cuda

[Install]
WantedBy=default.target
